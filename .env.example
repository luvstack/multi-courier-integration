## Environment ##
NODE_ENV=development


## Server ##
PORT=3000
HOST=localhost


## Setup jet-logger ##
JET_LOGGER_MODE=console 
JET_LOGGER_FILEPATH=jet-logger.log
JET_LOGGER_TIMESTAMP=true
JET_LOGGER_FORMAT=line

## Retry ##
COURIER_RETRY_COUNT=3

## URBANEBOLT ##
URBANEBOLT_BASE_URL=
URBANEBOLT_API_VERSION=
URBANEBOLT_USERNAME=
URBANEBOLT_PASSWORD=
URBANEBOLT_TIMEOUT=

## Redis ##
# If REDIS_URL is set (redis://... or rediss://...) it is used; otherwise host/port/password.
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

## PostgreSQL ##
# If DATABASE_URL is set, it is used; the individual DB_* values are ignored.
DATABASE_URL=
DB_DIALECT=postgres
DB_LOGGING=false

# Fallback when DATABASE_URL is not set
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
